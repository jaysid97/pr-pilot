# Copy this file to .env and fill in your values.
# Never commit .env to git.

# ── GitHub ──────────────────────────────────────────────────
# A random secret you choose; paste the same value in GitHub
# repo Settings → Webhooks → Secret
GITHUB_WEBHOOK_SECRET=your-secret-here

# ── Switch ──────────────────────────────────────────────────
# URL of the Switch server (Switch Console runs it locally)
SWITCH_SERVER_URL=http://host.docker.internal:8080

# The room name defined in pr-pilot.template.yaml
SWITCH_ROOM_NAME=pr-reviews

# Only needed if Switch is configured with API auth
SWITCH_API_KEY=

# ── GitHub API (for approve/block actions) ──────────────────
# Personal access token with repo scope (read + write PR reviews)
GITHUB_TOKEN=ghp_your_token_here

# ── Optional: Cloudflare Tunnel ─────────────────────────────
# CLOUDFLARE_TUNNEL_TOKEN=

